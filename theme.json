{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "base",         "name": "Base",         "color": "#ffffff" },
        { "slug": "contrast",     "name": "Contrast",     "color": "#2b2b2b" },
        { "slug": "contrast-2",   "name": "Contrast 2",   "color": "#000000" },
        { "slug": "surface-1",    "name": "Surface 1",    "color": "#f5f5f5" },
        { "slug": "surface-2",    "name": "Surface 2",    "color": "#e3e3e3" },
        { "slug": "surface-3",    "name": "Surface 3",    "color": "#cfcfcf" },
        { "slug": "surface-dark", "name": "Surface Dark", "color": "#1f1f1f" },
        { "slug": "border",       "name": "Border",       "color": "#e2e2e2" },
        { "slug": "muted",        "name": "Muted",        "color": "#6f6f6f" },
        { "slug": "link",         "name": "Link",         "color": "#2563eb" },
        { "slug": "link-hover",   "name": "Link Hover",   "color": "#1e40af" },
        { "slug": "error",        "name": "Error",        "color": "#b3261e" }
      ]
    },
    "shadow": {
      "defaultShadow": false,
      "presets": [
        { "slug": "soft",     "name": "Soft",     "shadow": "0 4px 12px rgba(17, 17, 17, 0.06)" },
        { "slug": "lifted",   "name": "Lifted",   "shadow": "0 10px 30px rgba(17, 17, 17, 0.10)" },
        { "slug": "dramatic", "name": "Dramatic", "shadow": "0 24px 60px rgba(17, 17, 17, 0.18)" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": false,
      "lineHeight": true,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif"
        },
        {
          "slug": "heading",
          "name": "Heading",
          "fontFamily": "Georgia, \"Times New Roman\", Times, serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "xx-small", "name": "XX Small", "size": "0.75rem",   "fluid": false },
        { "slug": "x-small",  "name": "X Small",  "size": "0.875rem",  "fluid": false },
        { "slug": "small",    "name": "Small",    "size": "1rem",      "fluid": false },
        { "slug": "medium",   "name": "Medium",   "size": "1.125rem",  "fluid": false },
        { "slug": "large",    "name": "Large",    "size": "1.3125rem", "fluid": false },
        { "slug": "x-large",  "name": "X Large",  "size": "1.625rem",  "fluid": false },
        { "slug": "xx-large", "name": "XX Large", "size": "2.625rem",  "fluid": { "min": "2rem", "max": "2.625rem" } },
        { "slug": "huge",     "name": "Huge",     "size": "3.25rem",   "fluid": { "min": "2.5rem", "max": "3.25rem" } }
      ]
    },
    "layout": {
      "contentSize": "1120px",
      "wideSize": "1168px"
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "css": "img{max-width:100%;height:auto}.has-border-color{border-style:solid}",
    "color": {
      "background": "var(--wp--preset--color--surface-1)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7",
      "letterSpacing": "0.01em"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "1.25rem",
        "right": "1.25rem"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "400",
          "lineHeight": "1.15"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.1" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.15" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.25" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--link)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--link-hover)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--contrast-2)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "width": "2px", "style": "solid", "color": "var(--wp--preset--color--contrast-2)", "radius": "5px" },
        "spacing": {
          "padding": { "top": "0.75em", "bottom": "0.75em", "left": "1.5em", "right": "1.5em" }
        },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500", "textDecoration": "none" },
        ":hover": { "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast-2)" } },
        ":focus": { "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast-2)" } },
        ":active": { "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast-2)" } }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--muted)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "400"
        }
      },
      "core/post-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            ":hover": { "color": { "text": "var(--wp--preset--color--link)" } }
          }
        }
      },
      "core/post-excerpt": {
        "color": { "text": "var(--wp--preset--color--muted)" }
      },
      "core/image": {
        "border": { "radius": "6px" }
      },
      "core/separator": {
        "color": { "text": "var(--wp--preset--color--border)" }
      },
      "core/quote": {
        "border": {
          "left": { "color": "var(--wp--preset--color--link)", "width": "3px" }
        },
        "spacing": { "padding": { "left": "1.5rem" } },
        "typography": { "fontStyle": "italic" }
      },
      "core/pullquote": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--x-large)" }
      },
      "core/navigation": {
        "typography": { "fontSize": "var(--wp--preset--font-size--small)", "textTransform": "uppercase", "letterSpacing": "0.05em" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "sidebar", "title": "Sidebar", "area": "uncategorized" }
  ]
}
